# Local routing-eval configuration.
#
# Copy to .env (gitignored). scripts/eval-gate.mjs and scripts/eval-routing.mjs
# load it when present; variables already set in the shell take precedence.
# Node 20.12+ is required for the loader — on older Node, export these in the
# shell instead.
#
# Record a baseline or run the gate through the direct Messages API provider,
# the clean-room transport (no CLI, hooks, plugins or CLAUDE.md):
#
#   npm run eval:baseline -- --provider anthropic --concurrency 2
#   npm run eval:gate -- --concurrency 2
#
# --concurrency 2 is for metered gateways; the default 4 trips a per-minute
# quota. Direct Anthropic access tolerates the default.

# Key for the Messages API. ANTHROPIC_API_KEY is also honoured.
NDV_ANTHROPIC_API_KEY=

# Anthropic-compatible gateway, if any. Leave unset to call Anthropic directly.
# Example: https://gateway.example.com/v1
NDV_ANTHROPIC_BASE_URL=

# label=served-id pairs, comma-separated. Some gateways resolve a bare alias to
# a different snapshot than Anthropic does; this keeps each baseline row
# measuring the model its label names. Leave unset for direct access.
# Example: claude-opus-5=claude-opus-5-0
NDV_ANTHROPIC_MODEL_ALIASES=

# Ollama cloud, only for `--models glm-5.3-flash`.
OLLAMA_API_KEY=
